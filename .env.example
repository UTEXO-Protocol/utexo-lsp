# Core server
SERVER_ADDR=:8080
DATABASE_DRIVER=sqlite
DATABASE_URL=utexo_lsp.db

# Upstream node APIs
LSP_BASE_URL=http://127.0.0.1:3001
LSP_TOKEN=
RGB_NODE_BASE_URL=http://127.0.0.1:3001
RGB_NODE_TOKEN=
HTTP_TIMEOUT=15s
CRON_EVERY=30s

# Invoice / transfer policy
SENDRGB_FEE_RATE=1
MIN_CONFIRMATIONS=1
EXPIRY_MATCH_TOLERANCE_SEC=5
MIN_AMT_MSAT=3000000
DEFAULT_RGB_ASSIGNMENT=Any

# Lightning Address
LIGHTNING_ADDRESS_DOMAIN_URL=http://127.0.0.1:8080
LIGHTNING_ADDRESS_SHORT_DESCRIPTION=Payment to utexo-lsp
LIGHTNING_ADDRESS_MIN_SENDABLE_MSAT=3000000
LIGHTNING_ADDRESS_MAX_SENDABLE_MSAT=3000000

# Async payments (APay)
APAY_BEARER_TOKEN=
APAY_INBOUND_INVOICE_EXPIRY=3600s
APAY_OUTBOUND_INVOICE_EXPIRY=900s
APAY_INBOUND_MIN_FINAL_CLTV_EXPIRY_DELTA=144
APAY_OUTBOUND_MIN_FINAL_CLTV_EXPIRY_DELTA=42
APAY_CLAIM_MARGIN_BLOCKS=12

# Channel / asset policy
DEFAULT_CHANNEL_CAPACITY_SAT=200000
DEFAULT_CHANNEL_ASSET_AMOUNT=1
DEFAULT_CHANNEL_PUSH_MSAT=0
# Comma-separated allowlist, for example: assetA,assetB
# Assets this LSP serves: accepts, pays out, and provisions a channel in for
# every connected peer. The payout asset (LNUSDT) goes here — never canonical USDT.
SUPPORTED_ASSET_IDS=

DEFAULT_VIRTUAL_OPEN_MODE=

# Cross-asset conversion
#
# Lets the two legs of one APay payment carry different assets, 1:1:
#
#   buyer --(USDT)--> LSP        inbound leg, quoted by the LNURL callback
#   LSP --(LNUSDT)--> merchant   outbound leg, the receiver's own asset
#
# Needed because an APay invoice is hosted: the LSP signs it, so it is the payee
# and a node-level swap is impossible. Atomicity comes from the shared payment
# hash. See internal/lspapi/convertible_asset.go.
#
# Example (LNUSDT = payout asset, USDT = canonical asset users already hold):
#   SUPPORTED_ASSET_IDS=rgb:LNUSDT
#   CONVERTIBLE_ASSET_IDS=rgb:USDT
#   CONVERTIBLE_PAIRS=rgb:LNUSDT|rgb:USDT
#   PAYOUT_ASSET_PREFERENCE=rgb:USDT
#   CHANNEL_PROVISION_GRACE=30s
# Leave all four empty/0 to disable conversion (the default).

# Comma-separated. Canonical USDT: accepted and paid out over a channel the peer
# funded itself, never provisioned. Putting it in SUPPORTED_ASSET_IDS instead
# gives every peer a second channel, burns inventory in an asset this LSP does
# not issue, and makes every peer's payout asset ambiguous.
CONVERTIBLE_ASSET_IDS=

# Comma-separated pairs "<asset_id>|<asset_id>" ("|" because contract ids contain
# ":"). One entry per pair, order irrelevant — LNUSDT|USDT serves both the
# checkout and the refund.
#
# THIS IS THE ENTIRE AUTHORIZATION for the 1:1 rate: the two assets are
# independent contracts with nothing on-chain relating them, so convertibility is
# an operator statement and the payer trusts this LSP for the outbound leg.
# Payout-eligibility is not enough — the pair must be declared. Precisions must
# match; a malformed entry is logged and skipped, not fatal.
CONVERTIBLE_PAIRS=

# Comma-separated, priority order. Tie-break for a peer holding channels in two
# payout-eligible assets — the buyer after a checkout, with its own USDT channel
# plus the LNUSDT one the cron opened. Set it to canonical USDT so a refund comes
# back in what the buyer paid with. Unset, the LSP refuses to guess and the
# address advertises no payout asset at all.
PAYOUT_ASSET_PREFERENCE=

# Duration (e.g. 30s). How long the cron leaves a newly seen peer with no channels
# alone. Between a self-funding buyer's connect and its own funding tx it looks
# exactly like a peer waiting to be served, and without the grace the cron hands
# it an LNUSDT channel it never asked for. 0 disables.
CHANNEL_PROVISION_GRACE=0

# UTXO maintenance
UTXO_MIN_COUNT=0
UTXO_TARGET_COUNT=0
UTXO_SIZE_SAT=32000
UTXO_FEE_RATE=1
UTXO_SKIP_SYNC=false
